        "properties": {
          "path": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "category": {"enum": ["hard_rule", "security", "bug"]},
          "rule_id": {"enum": ["HR1", "HR2", "HR3", "HR4", "HR5", "HR6", "HR7", "HR8", "HR9", null]},
          "severity": {"enum": ["high", "medium", "low"]},
          "title": {"type": "string"},
          "detail": {"type": "string"},
          "suggestion": {"type": "string"}
        }
      }
    }
  }
}
