# Copy to .env for local development. Placeholders only: never commit real values.
# Load with: uv run --env-file .env python app/manage.py runserver

# Required when DJANGO_DEBUG is false. In Azure this comes from Key Vault.
DJANGO_SECRET_KEY=
# true for local development only. Defaults to false.
DJANGO_DEBUG=true
# Comma separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Defaults to true when DJANGO_DEBUG is false.
DJANGO_SECURE_SSL_REDIRECT=

# Container only.
GUNICORN_WORKERS=2

# Fabric SQL analytics endpoint host name (M5). Leave empty for stub data.
FABRIC_SQL_ENDPOINT=
