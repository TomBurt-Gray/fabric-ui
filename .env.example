# Copy to .env for local development. Placeholders only: never commit real values.
# Load with: uv run --env-file .env python app/manage.py runserver

# Required when DJANGO_DEBUG is false. In Azure this comes from Key Vault.
DJANGO_SECRET_KEY=
# true for local development only. Defaults to false.
DJANGO_DEBUG=true
# Comma separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Defaults to true when DJANGO_DEBUG is false.
DJANGO_SECURE_SSL_REDIRECT=

# Local dev sign in shim. Needs DJANGO_DEBUG=true; refuses to run on App Service.
DEV_AUTH_ENABLED=true
# Comma separated: viewer, report_user, admin, support.
DEV_AUTH_ROLES=viewer,report_user
DEV_AUTH_NAME="Dev User"
DEV_AUTH_EMAIL=dev.user@example.test
DEV_AUTH_OBJECT_ID=00000000-0000-0000-0000-000000000001

# Per environment config. Defaults to the repo config/ folder and branding.example.yaml.
CONFIG_DIR=
BRANDING_CONFIG=
AUDIT_CONFIG=

# Container only.
GUNICORN_WORKERS=2

# Fabric SQL analytics endpoint host name (M5). Leave empty for stub data.
FABRIC_SQL_ENDPOINT=
